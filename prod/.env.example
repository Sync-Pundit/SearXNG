# SyncPundit SearXNG environment for the `!env` settings tags.
# Copy to `.env`, fill in real values, and load into the SearXNG process
# environment at start.  NEVER commit the real `.env` (see .gitignore).

# Session/cookie signing secret. Generate with: openssl rand -hex 32
SEARXNG_SECRET=

# Brave Search API key (https://api-dashboard.search.brave.com/). Free: about 2k/month.
BRAVE_API_KEY=

# There is no URLSCAN_API_KEY here. urlscan.io is deliberately not a SearXNG
# engine in this fork; see the note in settings.yml for where it lives instead.

# Serper API key (https://serper.dev) for the conditional fallback plugin
# (searx/plugins/serper_fallback.py). Without it the plugin stays inactive.
# 1 credit per fired request; only fires when Google returns nothing.
SERPER_API_KEY=
