{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "searxng",
  "main": "src/index.js",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "SERPER_MAX_PAGE": "5",
    "SERPER_PRIMARY_ENGINES": "google,google cse,dogpile,dogpile images,yahoo"
  },
  "assets": {
    "directory": ".assets",
    "binding": "ASSETS"
  },
  "containers": [
    {
      "name": "searxng-runtime",
      "class_name": "SearxngContainer",
      "image": "./container.Dockerfile",
      "image_build_context": "..",
      "instance_type": "basic",
      "max_instances": 1,
      "rollout_step_percentage": 100
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SEARXNG_CONTAINER",
        "class_name": "SearxngContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SearxngContainer"]
    }
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 0.05
    }
  }
}
