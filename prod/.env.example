# SyncPundit SearXNG — environment for the `!env` settings tags.
# Copy to `.env`, fill in real values, and load into the SearXNG process
# environment at start.  NEVER commit the real `.env` (see .gitignore).

# Session/cookie signing secret. Generate with: openssl rand -hex 32
SEARXNG_SECRET=

# Brave Search API key (https://api-dashboard.search.brave.com/) — free ~2k/mo
BRAVE_API_KEY=

# NOTE: no URLSCAN_API_KEY here — urlscan.io is deliberately not a SearXNG
# engine in this fork; see the note in settings.yml for where it lives instead.
